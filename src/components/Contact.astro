<section id="contact" class="contact-section">
  <div class="container contact-container">
    <div class="contact-content">
      <p class="contact-eyebrow">CONTACT</p>
      <h2>Een project in gedachten?</h2>
      <p class="contact-text">
        Vertel kort wat je wil realiseren. Jens neemt contact op om de mogelijkheden te
        bespreken.
      </p>

      <address class="contact-details">
        <a href="tel:+32470070975">
          <span>Telefoon</span>
          0470 07 09 75
        </a>
        <a href="mailto:jensgrobben123@gmail.com">
          <span>E-mail</span>
          jensgrobben123@gmail.com
        </a>
      </address>
    </div>

    <form
      class="contact-form"
      action="mailto:jensgrobben123@gmail.com"
      method="post"
      enctype="text/plain"
    >
      <div class="form-field">
        <label for="name">Naam</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>

      <div class="form-field">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="form-field">
        <label for="phone">Telefoon</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" />
      </div>

      <div class="form-field">
        <label for="message">Bericht</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>

      <button type="submit">Verstuur aanvraag</button>
    </form>
  </div>
</section>
